rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserEmail() {
      return (request.auth != null && request.auth.token != null && ('email' in request.auth.token) && request.auth.token.email != null) 
        ? request.auth.token.email.lower() 
        : '';
    }

    function getUserEmailRaw() {
      return (request.auth != null && request.auth.token != null && ('email' in request.auth.token) && request.auth.token.email != null) 
        ? request.auth.token.email 
        : '';
    }

    function isUserInGroupData(g) {
      let emailLower = getUserEmail();
      let emailRaw = getUserEmailRaw();
      let uid = request.auth.uid;
      
      return isSignedIn() && (
        g.ownerId == uid ||
        (('memberUids' in g) && (g.memberUids is list) && g.memberUids.hasAny([uid])) ||
        (('allowedEmails' in g) && (g.allowedEmails is list) && (
          (emailLower != '' && g.allowedEmails.hasAny([emailLower])) || 
          (emailRaw != '' && g.allowedEmails.hasAny([emailRaw]))
        )) ||
        (('sharedUsers' in g) && (g.sharedUsers is list) && g.sharedUsers.exists(u, 
          (emailLower != '' && ('email' in u) && u.email.lower() == emailLower) || 
          (emailRaw != '' && ('email' in u) && u.email == emailRaw) ||
          (('uid' in u) && u.uid == uid)
        ))
      );
    }

    function hasGroupAccess(gId) {
      let g = get(/databases/$(database)/documents/groups/$(gId)).data;
      return isUserInGroupData(g);
    }

    function canWriteGroupData(gId) {
      let g = get(/databases/$(database)/documents/groups/$(gId)).data;
      let emailLower = getUserEmail();
      let emailRaw = getUserEmailRaw();
      let uid = request.auth.uid;
      let isOwner = g.ownerId == uid;
      
      let isExplicitViewer = ('sharedUsers' in g) && (g.sharedUsers is list) && g.sharedUsers.exists(u, 
        ((emailLower != '' && ('email' in u) && u.email.lower() == emailLower) || 
         (emailRaw != '' && ('email' in u) && u.email == emailRaw) || 
         (('uid' in u) && u.uid == uid)) && 
        u.role == 'viewer'
      );
      return isUserInGroupData(g) && (isOwner || !isExplicitViewer);
    }

    function incoming() {
      return request.resource.data;
    }

    // --- Groups ---
    match /groups/{groupId} {
      allow read: if isUserInGroupData(resource.data);
      
      allow create: if isSignedIn() 
                    && incoming().ownerId == request.auth.uid 
                    && incoming().name is string 
                    && incoming().name.size() <= 100;
                    
      allow update: if isSignedIn() && (
        canWriteGroupData(groupId) ||
        // Allow joining user to add themselves to memberUids
        (incoming().diff(resource.data).affectedKeys().hasOnly(['memberUids']))
      ) && (
        // Owner can update anything
        resource.data.ownerId == request.auth.uid ||
        // Editor update rules:
        (
          // Cannot change ownerId
          incoming().ownerId == resource.data.ownerId &&
          // Editor cannot remove OTHER editors from sharedUsers
          (!('sharedUsers' in resource.data) || !('sharedUsers' in incoming()) || incoming().sharedUsers == resource.data.sharedUsers || resource.data.sharedUsers.all(u, 
            u.role != 'editor' || 
            (('email' in u) && getUserEmail() != '' && u.email.lower() == getUserEmail()) ||
            (('email' in u) && getUserEmailRaw() != '' && u.email == getUserEmailRaw()) ||
            (('uid' in u) && u.uid == request.auth.uid) ||
            incoming().sharedUsers.exists(iu, ('email' in iu) && ('email' in u) && iu.email.lower() == u.email.lower() && iu.role == 'editor')
          ))
        )
      ) && incoming().name is string && incoming().name.size() <= 100;

      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // --- Periods ---
      match /periods/{periodId} {
        allow read: if hasGroupAccess(groupId);
        allow create: if canWriteGroupData(groupId);
        allow update: if canWriteGroupData(groupId);
        allow delete: if canWriteGroupData(groupId);

        // --- Members ---
        match /members/{memberId} {
          allow read: if hasGroupAccess(groupId);
          allow create: if canWriteGroupData(groupId);
          allow update: if canWriteGroupData(groupId);
          allow delete: if canWriteGroupData(groupId);
        }

        // --- Member Groups ---
        match /memberGroups/{mgId} {
          allow read: if hasGroupAccess(groupId);
          allow create: if canWriteGroupData(groupId);
          allow update: if canWriteGroupData(groupId);
          allow delete: if canWriteGroupData(groupId);
        }

        // --- Fine Templates ---
        match /fineTemplates/{templateId} {
          allow read: if hasGroupAccess(groupId);
          allow create: if canWriteGroupData(groupId);
          allow update: if canWriteGroupData(groupId);
          allow delete: if canWriteGroupData(groupId);
        }

        // --- Fines ---
        match /fines/{fineId} {
          allow read: if hasGroupAccess(groupId);
          allow create: if canWriteGroupData(groupId);
          allow update: if canWriteGroupData(groupId);
          allow delete: if canWriteGroupData(groupId);
        }

        // --- Payments ---
        match /payments/{paymentId} {
          allow read: if hasGroupAccess(groupId);
          allow create: if canWriteGroupData(groupId);
          allow update: if canWriteGroupData(groupId);
          allow delete: if canWriteGroupData(groupId);
        }

        // --- Transactions ---
        match /transactions/{transactionId} {
          allow read: if hasGroupAccess(groupId);
          allow create: if canWriteGroupData(groupId);
          allow update: if canWriteGroupData(groupId);
          allow delete: if canWriteGroupData(groupId);
        }

        // --- Events ---
        match /events/{eventId} {
          allow read: if hasGroupAccess(groupId);
          allow create: if canWriteGroupData(groupId);
          allow update: if canWriteGroupData(groupId);
          allow delete: if canWriteGroupData(groupId);
        }

        // --- Goals ---
        match /goals/{goalId} {
          allow read: if hasGroupAccess(groupId);
          allow create: if canWriteGroupData(groupId);
          allow update: if canWriteGroupData(groupId);
          allow delete: if canWriteGroupData(groupId);
        }
      }
    }
  }
}
