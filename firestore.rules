rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserEmailLower() {
      return (request.auth.token != null && ('email' in request.auth.token) && request.auth.token.email != null) 
        ? request.auth.token.email.lower() 
        : '';
    }

    function getUserEmailRaw() {
      return (request.auth.token != null && ('email' in request.auth.token) && request.auth.token.email != null) 
        ? request.auth.token.email 
        : '';
    }

    function isUserInGroupData(g) {
      let emailLower = getUserEmailLower();
      let emailRaw = getUserEmailRaw();
      let uid = request.auth.uid;
      
      return isSignedIn() && g != null && (
        g.ownerId == uid ||
        (('memberUids' in g) && (g.memberUids is list) && g.memberUids.hasAny([uid])) ||
        (('allowedEmails' in g) && (g.allowedEmails is list) && (
          (emailLower != '' && g.allowedEmails.hasAny([emailLower])) || 
          (emailRaw != '' && g.allowedEmails.hasAny([emailRaw]))
        ))
      );
    }

    function isViewer(g) {
      let emailLower = getUserEmailLower();
      let emailRaw = getUserEmailRaw();
      let uid = request.auth.uid;

      return (
        (('viewerUids' in g) && (g.viewerUids is list) && g.viewerUids.hasAny([uid])) ||
        (('viewerEmails' in g) && (g.viewerEmails is list) && (
          (emailLower != '' && g.viewerEmails.hasAny([emailLower])) ||
          (emailRaw != '' && g.viewerEmails.hasAny([emailRaw]))
        ))
      );
    }

    function hasGroupAccess(gId) {
      let g = get(/databases/$(database)/documents/groups/$(gId)).data;
      return isUserInGroupData(g);
    }

    function canWriteGroupData(gId) {
      let g = get(/databases/$(database)/documents/groups/$(gId)).data;
      let isOwner = g.ownerId == request.auth.uid;
      return isUserInGroupData(g) && (isOwner || !isViewer(g));
    }

    function incoming() {
      return request.resource.data;
    }

    // --- Groups ---
    match /groups/{groupId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      
      allow create: if isSignedIn() 
                    && incoming().ownerId == request.auth.uid 
                    && incoming().name is string 
                    && incoming().name.size() <= 100;
                    
      allow update: if isSignedIn() && (
        // 1. Owner can update anything
        resource.data.ownerId == request.auth.uid ||
        // 2. Any user in group or joining/leaving can update group metadata, keeping ownerId unchanged
        (
          (isUserInGroupData(resource.data) || isUserInGroupData(incoming())) &&
          incoming().ownerId == resource.data.ownerId
        )
      ) && (!('name' in incoming()) || (incoming().name is string && incoming().name.size() <= 100));

      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // --- Periods ---
      match /periods/{periodId} {
        allow read: if hasGroupAccess(groupId);
        allow create: if canWriteGroupData(groupId);
        allow update: if canWriteGroupData(groupId);
        allow delete: if canWriteGroupData(groupId);

        // --- Members ---
        match /members/{memberId} {
          allow read: if hasGroupAccess(groupId);
          allow create: if canWriteGroupData(groupId);
          allow update: if canWriteGroupData(groupId);
          allow delete: if canWriteGroupData(groupId);
        }

        // --- Member Groups ---
        match /memberGroups/{mgId} {
          allow read: if hasGroupAccess(groupId);
          allow create: if canWriteGroupData(groupId);
          allow update: if canWriteGroupData(groupId);
          allow delete: if canWriteGroupData(groupId);
        }

        // --- Fine Templates ---
        match /fineTemplates/{templateId} {
          allow read: if hasGroupAccess(groupId);
          allow create: if canWriteGroupData(groupId);
          allow update: if canWriteGroupData(groupId);
          allow delete: if canWriteGroupData(groupId);
        }

        // --- Fines ---
        match /fines/{fineId} {
          allow read: if hasGroupAccess(groupId);
          allow create: if canWriteGroupData(groupId);
          allow update: if canWriteGroupData(groupId);
          allow delete: if canWriteGroupData(groupId);
        }

        // --- Payments ---
        match /payments/{paymentId} {
          allow read: if hasGroupAccess(groupId);
          allow create: if canWriteGroupData(groupId);
          allow update: if canWriteGroupData(groupId);
          allow delete: if canWriteGroupData(groupId);
        }

        // --- Transactions ---
        match /transactions/{transactionId} {
          allow read: if hasGroupAccess(groupId);
          allow create: if canWriteGroupData(groupId);
          allow update: if canWriteGroupData(groupId);
          allow delete: if canWriteGroupData(groupId);
        }

        // --- Events ---
        match /events/{eventId} {
          allow read: if hasGroupAccess(groupId);
          allow create: if canWriteGroupData(groupId);
          allow update: if canWriteGroupData(groupId);
          allow delete: if canWriteGroupData(groupId);
        }

        // --- Goals ---
        match /goals/{goalId} {
          allow read: if hasGroupAccess(groupId);
          allow create: if canWriteGroupData(groupId);
          allow update: if canWriteGroupData(groupId);
          allow delete: if canWriteGroupData(groupId);
        }

        // --- Recurring Fines ---
        match /recurringFines/{recurringFineId} {
          allow read: if hasGroupAccess(groupId);
          allow create: if canWriteGroupData(groupId);
          allow update: if canWriteGroupData(groupId);
          allow delete: if canWriteGroupData(groupId);
        }

        // --- Envelopes ---
        match /envelopes/{envelopeId} {
          allow read: if hasGroupAccess(groupId);
          allow create: if canWriteGroupData(groupId);
          allow update: if canWriteGroupData(groupId);
          allow delete: if canWriteGroupData(groupId);
        }

        // --- Fine Audit Logs ---
        match /fineAuditLogs/{logId} {
          allow read: if hasGroupAccess(groupId);
          allow create: if canWriteGroupData(groupId);
          allow update: if canWriteGroupData(groupId);
          allow delete: if canWriteGroupData(groupId);
        }
      }
    }
  }
}
